<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Kafadanat.Contracts</PackageId>
    <Authors>Kafadanat</Authors>
    <Description>Integration event contracts for the Kafadanat service mesh.</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ozcancaparoglu/Kafadanat.Contracts</RepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>